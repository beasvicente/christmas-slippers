# Server-only Resend configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=re_replace_with_a_resend_api_key
GIFT_REQUEST_FROM_EMAIL="Christmas Slippers <wishes@your-verified-domain.example>"
GIFT_REQUEST_TO_EMAIL=your-private-workshop-inbox@example.com

# Required in production for a durable, serverless-safe request rate limit.
UPSTASH_REDIS_REST_URL=https://replace-with-your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_your_standard_rest_token
GIFT_REQUEST_RATE_LIMIT_SECRET=replace_with_a_long_random_secret

# Private invitation records reuse the server-only Upstash connection above.
# Set this to the deployed public origin used in generated invitation links.
INVITATION_PUBLIC_BASE_URL=https://your-production-domain.example
